---
import Logo from '../brand/Logo.astro';
import { site, hasAbn, hasLicence } from '../../data/site';
import { primaryNav } from '../../data/navigation';
import { getServices } from '../../lib/content';
import { url } from '../../lib/paths';

const services = await getServices();
const year = new Date().getFullYear();
const company = primaryNav.filter((item) => item.href !== '/services/');
---

<footer class="border-t border-line-dark bg-ink text-paper">
  <div class="container-page pb-10 pt-(--spacing-section)">
    <div class="grid gap-14 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_0.8fr_1.2fr] lg:gap-10">
      <div>
        <Logo layout="stacked" ground="dark" height={96} class="h-24 w-auto" />
        <p class="mt-6 max-w-[32ch] text-sm leading-relaxed text-muted-dark">
          Metal roofing across {site.base.regionPhrase}, {site.base.stateName}.
        </p>
        <a
          href={site.social.instagram}
          rel="me noopener"
          target="_blank"
          class="mt-5 inline-flex min-h-11 items-center gap-2.5 text-sm text-muted-dark transition-colors hover:text-paper"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.7"></rect>
            <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.7"></circle>
            <circle cx="17.6" cy="6.4" r="1.3" fill="currentColor"></circle>
          </svg>
          {site.social.instagramHandle}
          <span class="sr-only">(opens Instagram)</span>
        </a>
      </div>

      {
        services.length > 0 && (
          <nav aria-labelledby="footer-services">
            <h2 id="footer-services" class="label text-crimson">
              Services
            </h2>
            <ul class="mt-4">
              {services.map((service) => (
                <li>
                  <a
                    href={url(`/services/${service.id}/`)}
                    class="inline-block py-1.5 text-sm text-muted-dark transition-colors hover:text-paper"
                  >
                    {service.data.shortTitle ?? service.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <nav aria-labelledby="footer-company">
        <h2 id="footer-company" class="label text-crimson">
          Company
        </h2>
        <ul class="mt-4">
          {
            company.map((item) => (
              <li>
                <a href={url(item.href)} class="inline-block py-1.5 text-sm text-muted-dark transition-colors hover:text-paper">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="label text-crimson">Contact</h2>
        <ul class="mt-4 space-y-4">
          {
            site.contacts.map((contact) => (
              <li>
                <a href={`tel:${contact.phone}`} class="group block py-0.5">
                  <span class="label block text-muted-dark">{contact.name}</span>
                  <span class="tabular mt-1.5 block text-lg font-semibold transition-colors group-hover:text-rose">
                    {contact.display}
                  </span>
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${site.email}`}
              class="inline-block break-all py-1.5 text-sm text-muted-dark transition-colors hover:text-paper"
            >
              {site.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-3 border-t border-line-dark pt-6 text-2xs text-muted-dark sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.name}</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-1">
        {hasAbn && <span>ABN {site.abn}</span>}
        {hasLicence && <span>{site.licence.authority} licence {site.licence.number}</span>}
        <a href={url('/privacy/')} class="inline-block py-1.5 transition-colors hover:text-paper">Privacy</a>
      </div>
    </div>
  </div>
</footer>
