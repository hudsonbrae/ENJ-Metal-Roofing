---
/**
 * Inner-page opening. One family, several treatments:
 *   tone   ink (dark) or paper (light) ground
 *   aside  a named slot; when filled, the header splits into title + aside
 *          (used for calls to action and contact details, never filler text)
 */
import { url } from '../../lib/paths';

interface Props {
  title: string;
  intro?: string;
  /** Short label above the title. Optional; most pages do not need one. */
  eyebrow?: string;
  tone?: 'ink' | 'paper';
  /** Breadcrumb trail, excluding Home. */
  trail?: { label: string; href: string }[];
}

const { title, intro, eyebrow, tone = 'ink', trail = [] } = Astro.props;
const ink = tone === 'ink';
const hasAside = Astro.slots.has('aside');
---

<section
  class:list={[
    'relative',
    ink ? 'bg-ink text-paper' : 'border-b border-line bg-paper text-ink',
  ]}
>
  <div class="container-page pb-(--spacing-section) pt-10 sm:pt-14">
    {
      trail.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-10 sm:mb-14">
          <ol class:list={['label flex flex-wrap items-center gap-x-2', ink ? 'text-muted-dark' : 'text-muted']}>
            <li>
              <a href={url('/')} class="inline-block py-2 transition-colors hover:text-current">
                Home
              </a>
            </li>
            {trail.map((crumb, i) => (
              <li class="flex items-center gap-x-2">
                <span aria-hidden="true" class="opacity-50">
                  /
                </span>
                <a
                  href={url(crumb.href)}
                  aria-current={i === trail.length - 1 ? 'page' : undefined}
                  class="inline-block py-2 transition-colors hover:text-current"
                >
                  {crumb.label}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class:list={['grid gap-12', hasAside && 'lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:items-end lg:gap-20']}>
      <div class="min-w-0">
        {eyebrow && <p class:list={['label mb-6', ink ? 'text-crimson' : 'text-red']}>{eyebrow}</p>}
        <h1 class="t-display max-w-[15ch] text-5xl">{title}</h1>
        {
          intro && (
            <p class:list={['t-lead mt-7 max-w-[52ch]', ink ? 'text-muted-dark' : 'text-muted']}>{intro}</p>
          )
        }
        <slot />
      </div>
      {hasAside && <div class="min-w-0"><slot name="aside" /></div>}
    </div>
  </div>
</section>
