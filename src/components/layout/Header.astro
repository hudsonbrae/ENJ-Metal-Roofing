---
import { site, primaryContact } from '../../data/site';

const nav = [
  { label: 'Services', href: '/services/' },
  { label: 'Work', href: '/projects/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line-dark bg-ink">
  <div class="container-page flex items-center justify-between gap-6 py-4 lg:py-5">
    <a
      href="/"
      class="shrink-0"
      aria-label={`${site.name} — home`}
    >
      {/* The supplied lockup is a dark-ground asset: the wordmark is white. */}
      <img
        src="/brand/enj-logo.png"
        alt={site.name}
        width="1280"
        height="569"
        class="h-12 w-auto sm:h-14 lg:h-16"
        fetchpriority="high"
      />
    </a>

    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex items-center gap-9">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="relative block py-1 text-2xs uppercase transition-colors duration-200"
                style={`font-stretch:88%;font-weight:600;letter-spacing:var(--tracking-wider);color:${
                  isActive(item.href) ? 'var(--color-paper)' : 'var(--color-muted-dark)'
                }`}
                data-nav-link
              >
                {item.label}
                {isActive(item.href) && (
                  <span
                    class="absolute -bottom-0.5 left-0 h-px w-full"
                    style="background:var(--color-crimson)"
                    aria-hidden="true"
                  />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-6 lg:flex">
      <a
        href={`tel:${primaryContact.phone}`}
        class="py-2 text-2xs uppercase transition-colors duration-200"
        style="font-stretch:88%;font-weight:600;letter-spacing:var(--tracking-wider);color:var(--color-paper)"
      >
        {primaryContact.display}
      </a>
      <a
        href="/contact/"
        class="rounded-sm bg-cta px-5 py-3 text-2xs uppercase text-white transition-colors duration-200 hover:bg-red"
        style="font-stretch:88%;font-weight:600;letter-spacing:var(--tracking-wider)"
      >
        Free quote
      </a>
    </div>

    <button
      type="button"
      class="-mr-2 flex items-center gap-2.5 p-2 lg:hidden"
      style="color:var(--color-paper)"
      aria-label="Open menu"
      data-menu-open
    >
      <span class="label" style="opacity:.8">Menu</span>
      <svg width="20" height="12" viewBox="0 0 20 12" aria-hidden="true">
        <path d="M0 1h20M0 11h20" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>
</header>

{/* Native <dialog>: focus trapping, Escape and backdrop come from the
    platform with correct screen-reader semantics. No JS framework needed. */}
<dialog
  data-menu
  class="m-0 h-full max-h-none w-full max-w-none bg-ink p-0 text-paper backdrop:bg-ink-950/80"
  aria-label="Site menu"
>
  <div class="flex h-full flex-col">
    <div class="container-page flex items-center justify-between border-b border-line-dark py-4">
      <img
        src="/brand/enj-logo.png"
        alt=""
        width="1280"
        height="569"
        class="h-11 w-auto"
      />
      <button
        type="button"
        class="-mr-2 flex items-center gap-2.5 p-2"
        style="color:var(--color-paper)"
        aria-label="Close menu"
        data-menu-close
      >
        <span class="label" style="opacity:.8">Close</span>
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M1 1l16 16M17 1L1 17" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>

    <nav class="container-page flex-1 py-10" aria-label="Site">
      <ul class="flex flex-col">
        {
          nav.map((item, i) => (
            <li class="border-b border-line-dark">
              <a
                href={item.href}
                class="display flex items-baseline gap-5 py-5 text-3xl"
                style="color:var(--color-paper)"
              >
                <span
                  class="label"
                  style="color:var(--color-crimson);transform:translateY(-.4em)"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="container-page space-y-3 border-t border-line-dark py-8">
      {
        site.contacts.map((c) => (
          <a
            href={`tel:${c.phone}`}
            class="flex items-baseline justify-between gap-4 py-1"
          >
            <span class="label" style="color:var(--color-muted-dark)">{c.name}</span>
            <span class="text-lg" style="font-weight:600">{c.display}</span>
          </a>
        ))
      }
      <a
        href="/contact/"
        class="mt-5 block rounded-sm bg-cta px-6 py-4 text-center text-xs uppercase text-white"
        style="font-stretch:88%;font-weight:600;letter-spacing:var(--tracking-wider)"
      >
        Get a free quote
      </a>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const open = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const close = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  open?.addEventListener('click', () => {
    dialog?.showModal();
    document.body.style.overflow = 'hidden';
  });

  const dismiss = () => {
    dialog?.close();
    document.body.style.overflow = '';
  };

  close?.addEventListener('click', dismiss);
  dialog?.addEventListener('close', () => {
    document.body.style.overflow = '';
  });

  // Close on navigation so the back button behaves predictably.
  dialog?.querySelectorAll('a').forEach((a) => a.addEventListener('click', dismiss));
</script>
