---
import { primaryContact } from '../../data/site';
import { quoteHref } from '../../data/navigation';
---

{/* Measures the first 85% of the first screen from the top of the document.
    While any of it is visible the bar stays hidden, so it never competes
    with the page's own opening call to action. */}
<div data-actionbar-sentinel aria-hidden="true" class="pointer-events-none absolute left-0 top-0 h-[85svh] w-px"></div>

<div
  data-actionbar
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-line-dark bg-ink text-paper transition-transform duration-300 ease-expo lg:hidden"
  style="padding-bottom:env(safe-area-inset-bottom)"
>
  <div class="grid grid-cols-2">
    <a href={`tel:${primaryContact.phone}`} class="flex min-h-16 flex-col items-center justify-center gap-1">
      <span class="label text-muted-dark">Call {primaryContact.name}</span>
      <span class="tabular text-sm font-semibold">{primaryContact.display}</span>
    </a>
    <a href={quoteHref} class="btn btn-primary min-h-16 rounded-none">Get a free quote</a>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-actionbar]');
  const sentinel = document.querySelector<HTMLElement>('[data-actionbar-sentinel]');

  if (bar && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      const hidden = entry.isIntersecting;
      bar.classList.toggle('translate-y-full', hidden);
      bar.inert = hidden;
    }).observe(sentinel);
  } else if (bar) {
    bar.classList.remove('translate-y-full');
  }
</script>
