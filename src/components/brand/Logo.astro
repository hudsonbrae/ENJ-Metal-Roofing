---
/**
 * The ENJ logo. The single place the logo files are referenced.
 *
 * Both lockups are vector traces of ENJ's original artwork
 * (scripts/logo-vector.mjs), so they stay sharp at any size.
 *   horizontal  mark beside the wordmark; used in the header, where the
 *               stacked version's "ROOFING" line would be too small to read
 *   stacked     the original arrangement; used where there is room for it
 */
import horizontalDark from '../../assets/brand/enj-logo-horizontal-dark.svg';
import horizontalLight from '../../assets/brand/enj-logo-horizontal-light.svg';
import stackedDark from '../../assets/brand/enj-logo-stacked-dark.svg';
import stackedLight from '../../assets/brand/enj-logo-stacked-light.svg';
import { site } from '../../data/site';

interface Props {
  layout?: 'horizontal' | 'stacked';
  /** The ground the logo sits on. */
  ground?: 'dark' | 'light';
  /** Rendered height in CSS pixels. */
  height: number;
  priority?: boolean;
  /** Empty alt when a visible or aria label already names the business. */
  decorative?: boolean;
  class?: string;
}

const {
  layout = 'horizontal',
  ground = 'dark',
  height,
  priority = false,
  decorative = false,
  class: className,
} = Astro.props;

const files = {
  horizontal: { dark: horizontalDark, light: horizontalLight },
  stacked: { dark: stackedDark, light: stackedLight },
};
const source = files[layout][ground];
const width = Math.round((source.width / source.height) * height);
---

<img
  src={source.src}
  alt={decorative ? '' : site.name}
  width={width}
  height={height}
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
  class:list={['block max-w-full', className]}
/>
