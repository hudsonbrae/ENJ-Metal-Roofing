---
/**
 * The site's only button. Renders a link when given `href`, otherwise a
 * <button>. Styling lives in global.css (.btn and friends) so a plain form
 * <button> or a script can share it.
 */
type Variant = 'primary' | 'secondary' | 'secondary-dark';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: Variant;
  size?: Size;
  block?: boolean;
  class?: string;
  [attribute: string]: unknown;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  block = false,
  class: className,
  ...rest
} = Astro.props;

const classes = ['btn', `btn-${variant}`, size !== 'md' && `btn-${size}`, block && 'btn-block', className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
