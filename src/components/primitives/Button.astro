---
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'outline-dark';
  size?: 'md' | 'lg';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-3 rounded-sm font-sans uppercase ' +
  'transition-colors duration-200 ease-standard';

const sizes = {
  md: 'px-6 py-3.5 text-2xs tracking-wider',
  lg: 'px-8 py-4.5 text-xs tracking-wider',
};

const variants = {
  primary: 'bg-cta text-white hover:bg-red',
  outline: 'border border-ink/25 text-ink hover:bg-ink hover:text-paper',
  'outline-dark': 'border border-rose/35 text-paper hover:bg-paper hover:text-ink',
};
---

<a
  href={href}
  class:list={[base, sizes[size], variants[variant], className]}
  style="font-weight:600;font-stretch:88%"
  {...rest}
>
  <slot />
</a>
