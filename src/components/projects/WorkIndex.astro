---
/**
 * The homepage work list. A numbered index; on desktop, hovering or focusing
 * a row shows that project's photograph. On touch screens every row carries
 * its thumbnail inline instead. Scales from one project to dozens.
 */
import Photo from '../media/Photo.astro';
import { leadPhoto, projectLocation, type Project } from '../../lib/content';
import { url } from '../../lib/paths';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ol class="work-index border-t border-line">
  {
    projects.map((project, i) => {
      const photo = leadPhoto(project);
      const location = projectLocation(project);
      return (
        <li class="work-row relative border-b border-line">
          <a
            href={url(project.url)}
            class="group grid grid-cols-[3rem_minmax(0,1fr)] items-center gap-x-4 gap-y-3 py-6 sm:grid-cols-[4rem_minmax(0,1fr)_auto] sm:py-7"
          >
            <span class="label tabular text-red">{String(i + 1).padStart(2, '0')}</span>
            <span class="t-title text-2xl transition-transform duration-500 ease-expo group-hover:translate-x-2 lg:text-3xl">
              {project.data.title}
            </span>
            <span class="col-start-2 flex items-center gap-4 sm:col-start-3">
              {location && <span class="label text-muted">{location}</span>}
              {project.isFixture && (
                <span data-review-only class="label bg-ink px-2 py-1.5 text-paper">
                  Fixture
                </span>
              )}
            </span>
            {photo && (
              <span class="col-start-2 block w-36 sm:hidden">
                <Photo src={photo.src} alt="" use="thumb" ratio="3/2" />
              </span>
            )}
          </a>
          {photo && (
            <div class="work-preview pointer-events-none absolute right-[18%] top-1/2 z-10 hidden w-[min(22rem,28vw)] sm:block">
              <Photo src={photo.src} alt="" use="thumb" ratio="4/3" />
            </div>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  /* Preview only where hovering is real; otherwise the inline thumbnail shows. */
  .work-preview {
    opacity: 0;
    transform: translateY(-46%) rotate(-1.5deg) scale(0.96);
    transition:
      opacity 250ms var(--ease-standard),
      transform 500ms var(--ease-expo);
  }
  @media (hover: hover) and (pointer: fine) {
    .work-row:hover .work-preview,
    .work-row:focus-within .work-preview {
      opacity: 1;
      transform: translateY(-50%) rotate(0deg) scale(1);
    }
  }
  @media not ((hover: hover) and (pointer: fine)) {
    .work-preview {
      display: none;
    }
  }
</style>
