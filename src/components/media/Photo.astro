---
/**
 * Every content photograph goes through here, so every one is resized,
 * converted to AVIF/WebP with a JPEG fallback, and served at a size that
 * matches where it is used. Nothing ships the full-resolution original.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Use = 'hero' | 'feature' | 'card' | 'third' | 'thumb' | 'full' | 'lightbox';

interface Props {
  src: ImageMetadata;
  alt: string;
  use: Use;
  /** Crop to this aspect ratio (CSS syntax, e.g. "4/3"). Omit to keep the photo's own ratio. */
  ratio?: string;
  /** Fill the parent's height (the parent sets the size). */
  fill?: boolean;
  priority?: boolean;
  /** Development fixture: shows a label so it cannot be mistaken for ENJ work. */
  fixture?: boolean;
  /** Reveal on scroll. */
  reveal?: boolean;
  /** Crop anchor, e.g. "50% 30%". */
  position?: string;
  class?: string;
  imgClass?: string;
}

const {
  src,
  alt,
  use,
  ratio,
  fill = false,
  priority = false,
  fixture = false,
  reveal = false,
  position = '50% 50%',
  class: className,
  imgClass,
} = Astro.props;

// Widths are capped by the source size, so a small original is never upscaled.
const presets: Record<Use, { widths: number[]; sizes: string }> = {
  hero: { widths: [640, 900, 1200, 1600, 2000], sizes: '(min-width: 1024px) 42vw, 100vw' },
  feature: { widths: [640, 960, 1280, 1680, 2200], sizes: '(min-width: 1440px) 1312px, 92vw' },
  card: { widths: [480, 720, 960, 1280], sizes: '(min-width: 768px) 46vw, 92vw' },
  third: { widths: [400, 600, 800, 1000], sizes: '(min-width: 768px) 30vw, 92vw' },
  thumb: { widths: [240, 360, 480], sizes: '240px' },
  full: { widths: [800, 1200, 1600, 2000, 2560], sizes: '100vw' },
  lightbox: { widths: [1200, 1800, 2400], sizes: '92vw' },
};

const { widths, sizes } = presets[use];
const usable = widths.filter((w) => w <= src.width);
const finalWidths = usable.length > 0 ? usable : [src.width];
---

<div
  class:list={['photo relative overflow-hidden bg-paper-2', fill && 'h-full w-full', reveal && 'reveal-image', className]}
  style={ratio && !fill ? `aspect-ratio:${ratio}` : undefined}
>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={finalWidths}
    sizes={sizes}
    quality={78}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    layout="none"
    pictureAttributes={{ class: (ratio || fill) ? 'block h-full w-full' : 'block' }}
    class:list={['block', (ratio || fill) && 'h-full w-full object-cover', !ratio && !fill && 'h-auto w-full', imgClass]}
    style={`object-position:${position}`}
  />
  {
    fixture && (
      <span data-review-only class="label absolute left-3 top-3 bg-ink/90 px-2 py-1.5 text-paper">
        Development fixture
      </span>
    )
  }
</div>
