---
/**
 * Placeholder for photography ENJ has not yet supplied. Review mode only.
 *
 * It states the exact shot required, so the layout can be reviewed now and
 * the slot doubles as the photography brief. In launch mode it renders
 * nothing; callers decide how the layout closes up without it.
 */
import { reviewMode } from '../../lib/mode';

interface Props {
  /** Short name for the shot, e.g. "Hero", "Detail". */
  role: string;
  /** CSS aspect-ratio such as "16/9". Omit with `fill` to fill the parent. */
  ratio?: string;
  fill?: boolean;
  /** What the photograph needs to show. */
  brief: string;
  tone?: 'dark' | 'light';
  class?: string;
}

const { role, ratio = '4/3', fill = false, brief, tone = 'dark', class: className } = Astro.props;
const dark = tone === 'dark';
---

{
  reviewMode && (
    <figure
      data-review-only
      class:list={[
        'relative m-0 flex flex-col justify-between overflow-hidden',
        fill ? 'h-full min-h-72 w-full' : 'aspect-(--slot-ratio) w-full',
        dark ? 'bg-ink-950 text-muted-dark' : 'bg-paper-2 text-muted',
        className,
      ]}
      style={`--slot-ratio:${ratio}`}
      aria-label={`Photograph needed: ${brief}`}
    >
      <svg
        class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.07]"
        viewBox="0 0 120 60"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <path d="M-10 55 L20 18 L50 55 L80 18 L110 55 L140 18" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
      <div class="relative flex items-start justify-between gap-4 p-5 sm:p-6">
        <span class="label">{role}</span>
        {!fill && (
          <span class="label opacity-60" aria-hidden="true">
            {ratio.replace('/', ':')}
          </span>
        )}
      </div>
      <figcaption class="relative max-w-[44ch] p-5 pt-0 sm:p-6 sm:pt-0">
        <span class:list={['label mb-2.5 block', dark ? 'text-crimson' : 'text-red']}>Photograph needed</span>
        <span class="block text-sm leading-snug">{brief}</span>
      </figcaption>
    </figure>
  )
}
