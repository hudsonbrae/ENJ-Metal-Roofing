---
import { site } from '../data/site';
import { businessSchema, websiteSchema } from '../lib/seo/schema';

interface Props {
  /** Page title, without the brand suffix — required, so no page can ship untitled. */
  title: string;
  /** Meta description — required for the same reason. */
  description: string;
  image?: string;
  noindex?: boolean;
  /** Extra JSON-LD blocks for this page (Service, Breadcrumb, FAQPage…). */
  schemas?: unknown[];
}

const { title, description, image, noindex = false, schemas = [] } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image ?? '/brand/enj-og.jpg', Astro.site).toString();
const fullTitle = `${title} | ${site.name}`;

// Site-wide graphs render once, on every page, keyed by @id so Google
// resolves them to a single business entity.
const graphs = [businessSchema(), websiteSchema(), ...schemas].filter(Boolean);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_AU" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="geo.region" content="AU-NSW" />
<meta name="geo.placename" content={site.base.suburb} />

{
  graphs.map((graph) => (
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  ))
}
