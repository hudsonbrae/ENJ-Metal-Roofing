---
import { reviewMode } from '../../lib/mode';
---

{
  reviewMode && (
    <div data-review-only class="border-b border-line-dark bg-ink-950 text-muted-dark">
      <p class="container-page flex flex-wrap items-center gap-x-4 gap-y-1 py-2 text-2xs">
        <span class="label text-crimson">Review build</span>
        <span>
          Not live. Photography, draft services and wording marked for confirmation are shown here
          for ENJ to check, and are hidden in the launch build.
        </span>
      </p>
    </div>
  )
}
