---
import Base from '../layouts/Base.astro';
import Button from '../components/primitives/Button.astro';
import SectionLabel from '../components/primitives/SectionLabel.astro';
import Photo from '../components/media/Photo.astro';
import AssetSlot from '../components/media/AssetSlot.astro';
import CallList from '../components/contact/CallList.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import WorkIndex from '../components/projects/WorkIndex.astro';
import Awaiting from '../components/review/Awaiting.astro';
import { site, primaryContact } from '../data/site';
import { quoteHref } from '../data/navigation';
import { processConfirmed, processSteps } from '../data/process';
import { reviewMode } from '../lib/mode';
import { url } from '../lib/paths';
import {
  detailPhotos,
  getProjects,
  getServices,
  getTestimonials,
  heroWorkmanship,
  leadPhoto,
} from '../lib/content';

const projects = await getProjects();
const services = await getServices();
const testimonials = await getTestimonials();
const heroShot = await heroWorkmanship();

const [featured, ...otherProjects] = projects;

// Hero: the workmanship photo chosen for it, otherwise the featured
// project's lead photo.
const heroPhoto = heroShot?.data ?? (featured ? leadPhoto(featured) : undefined);
const heroIsFixture = !heroShot && Boolean(featured?.isFixture);
const heroFocus = heroShot?.data.focus ?? '50% 50%';

// The featured work card must not repeat the hero photo. If the hero came
// from the project itself, use another of its shots; without one, the job
// goes into the index instead.
const featureShot = featured
  ? heroShot
    ? leadPhoto(featured)
    : (featured.data.gallery.find((p) => p.kind !== 'detail' && p.src !== heroPhoto?.src) ??
      featured.data.beforeAfter[0]?.after)
  : undefined;
const indexProjects = featureShot ? otherProjects : projects;
const details = await detailPhotos(projects, 3);
const showProcess = processConfirmed || reviewMode;

const junctions = ['Ridge capping', 'Valleys', 'Flashings', 'Penetrations', 'Fasteners'];
---

<Base
  title="Metal Roofing in the Shoalhaven"
  description={`Metal roofing across ${site.base.regionPhrase}, NSW, for coastal salt air and bushfire-prone land. Call John or Ethan, or ask for a free quote online.`}
>
  {/* Hero. Split: message and actions left, the work right. */}
  <section class="hero bg-ink text-paper">
    <div class="grid lg:min-h-(--hero-h) lg:grid-cols-12">
      <div class="hero-copy flex flex-col justify-center pb-14 pt-12 sm:pb-20 sm:pt-16 lg:col-span-7 lg:py-14 lg:pr-12">
        <h1 class="hero-title t-display">Roofs built for the South Coast</h1>
        <p class="t-lead mt-7 max-w-[38ch] text-muted-dark">
          Metal roofing for salt air, coastal wind and bushfire-prone land, across {site.base.regionPhrase}.
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button href={quoteHref} size="lg">Get a free quote</Button>
          <Button href={`tel:${primaryContact.phone}`} variant="secondary-dark" size="lg">
            <span>Call {primaryContact.name}</span>
            <span class="tabular font-normal opacity-80">{primaryContact.display}</span>
          </Button>
        </div>
      </div>

      <div class="relative lg:col-span-5">
        {
          heroPhoto ? (
            <Photo
              src={heroPhoto.src}
              alt={heroPhoto.alt}
              use="hero"
              fill
              priority
              position={heroFocus}
              fixture={heroIsFixture}
              class="settle aspect-4/5 sm:aspect-16/10 lg:absolute lg:inset-0 lg:aspect-auto"
            />
          ) : reviewMode ? (
            <AssetSlot
              role="Hero"
              fill
              class="aspect-4/5 sm:aspect-16/10 lg:absolute lg:inset-0 lg:aspect-auto"
              brief="A completed ENJ roof, ground level or low drone, with the house in context and light raking across the ribs."
            />
          ) : (
            <div class="flex h-full flex-col justify-end px-gutter pb-14 lg:border-l lg:border-line-dark lg:px-12 lg:pb-14">
              <CallList />
            </div>
          )
        }
      </div>
    </div>
  </section>

  {/* Statement. Editorial, no label: the one idea the site is built on. */}
  <section class="bg-paper py-(--spacing-section-lg)">
    <div class="container-page grid gap-10 lg:grid-cols-12">
      <h2 class="reveal t-headline text-4xl lg:col-span-9">
        A roof takes more weather than any other part of a house, and gets looked at the least.
      </h2>
      <p class="reveal t-lead text-muted lg:col-span-5 lg:col-start-6" style="--d:1">
        Near the coast, how long a metal roof lasts depends on choices made before any work starts: the
        grade of steel, the fasteners and how the flashings are detailed. They are worth asking about
        before accepting a quote.
      </p>
    </div>
  </section>

  {/* Work. A feature image leads; the rest sit in a numbered index. */}
  {
    featured ? (
      <section class="bg-paper pb-(--spacing-section)">
        <div class="container-page">
          <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
            <div>
              <SectionLabel index="01" text="Work" />
              <h2 class="t-headline mt-5 text-4xl">Recent work</h2>
            </div>
            <a href={url('/projects/')} class="label link py-2 text-red">
              All work
            </a>
          </div>
          {featureShot && <ProjectCard project={featured} size="feature" photo={featureShot} />}
          {indexProjects.length > 0 && (
            <div class:list={[featureShot && 'mt-16 sm:mt-20']}>
              <WorkIndex projects={indexProjects} />
            </div>
          )}
        </div>
      </section>
    ) : (
      <section class="bg-paper pb-(--spacing-section)">
        <div class="container-page flex flex-col gap-6 border-y border-line py-8 sm:flex-row sm:items-center sm:justify-between">
          <p class="t-title text-xl">
            Project photographs are on their way. Recent jobs are on Instagram in the meantime.
          </p>
          <Button href={site.social.instagram} variant="secondary" target="_blank" rel="me noopener">
            {site.social.instagramHandle}
          </Button>
        </div>
      </section>
    )
  }

  {/* Detail. Where roofs fail, shown up close. */}
  <section class="bg-ink py-(--spacing-section) text-paper">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-4">
          <h2 class="reveal t-headline text-4xl">Where roofs fail</h2>
          <p class="reveal t-lead mt-6 text-muted-dark" style="--d:1">
            Most leaks in a metal roof start at a junction, not in the middle of a sheet. These are the
            details worth looking at closely.
          </p>
          <ul class="mt-10 border-t border-line-dark">
            {
              junctions.map((item, i) => (
                <li class="reveal flex items-baseline gap-4 border-b border-line-dark py-3.5" style={`--d:${i + 2}`}>
                  <span class="label tabular text-crimson">{String(i + 1).padStart(2, '0')}</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        {
          details.length > 0 ? (
            <div class="grid gap-4 sm:grid-cols-2 sm:gap-5 lg:col-span-8 lg:col-start-5">
              {details.map(({ photo, fixture }, i) => (
                <figure class:list={['m-0', i === 0 && details.length > 1 && 'sm:row-span-2']}>
                  <Photo
                    src={photo.src}
                    alt={photo.alt}
                    use={i === 0 ? 'card' : 'third'}
                    ratio={i === 0 && details.length > 1 ? '4/5' : '4/3'}
                    fill={false}
                    fixture={fixture}
                    reveal
                  />
                  {photo.caption && <figcaption class="mt-3 text-sm text-muted-dark">{photo.caption}</figcaption>}
                </figure>
              ))}
            </div>
          ) : (
            reviewMode && (
              <div class="grid gap-4 sm:grid-cols-2 sm:gap-5 lg:col-span-8 lg:col-start-5">
                <AssetSlot role="Detail" ratio="4/5" class="sm:row-span-2" brief="Close-up of ridge capping meeting the sheet ends, showing the fastener line." />
                <AssetSlot role="Detail" ratio="4/3" brief="Close-up of a valley or apron flashing." />
                <AssetSlot role="Detail" ratio="4/3" brief="A straight run of fasteners along the ribs, shot along the roof plane." />
              </div>
            )
          )
        }
      </div>
    </div>
  </section>

  {/* Services. The numbered index is the site's signature list. */}
  {
    services.length > 0 && (
      <section class="bg-paper py-(--spacing-section)">
        <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-8">
          <div class="lg:col-span-4">
            <SectionLabel index="02" text="Services" />
            <h2 class="t-headline mt-5 max-w-[12ch] text-4xl">What ENJ does</h2>
            <a href={url('/services/')} class="label link mt-8 inline-block py-2 text-red">
              All services
            </a>
            {services.some((s) => s.data.draft) && (
              <Awaiting
                note="Services marked draft are shown for review. ENJ to confirm which are advertised; unconfirmed ones are hidden at launch."
                class="mt-10"
              >
                <span />
              </Awaiting>
            )}
          </div>
          <ol class="border-t border-line lg:col-span-8">
            {services.map((service, i) => (
              <li class="border-b border-line">
                <a href={url(`/services/${service.id}/`)} class="group grid grid-cols-[3rem_minmax(0,1fr)] gap-x-4 py-7 sm:grid-cols-[4rem_minmax(0,1fr)]">
                  <span class="label tabular pt-2 text-red">{String(i + 1).padStart(2, '0')}</span>
                  <span>
                    <span class="t-title block text-2xl transition-colors group-hover:text-red lg:text-3xl">
                      {service.data.title}
                    </span>
                    <span class="mt-3 block max-w-[56ch] text-muted">{service.data.summary}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {/* Local conditions. Two conditions, side by side. */}
  <section class="bg-paper-2 py-(--spacing-section)">
    <div class="container-page">
      <h2 class="reveal t-headline max-w-[18ch] text-4xl">Specified for where the roof is going</h2>
      <div class="mt-14 grid gap-12 md:grid-cols-2 md:gap-16">
        <article class="reveal border-t-2 border-ink pt-6">
          <h3 class="t-title text-2xl">Salt air</h3>
          <p class="mt-4 max-w-[52ch] text-muted">
            BlueScope specifies different COLORBOND&reg; steel grades by distance from breaking surf.
            Standard COLORBOND&reg; steel is not recommended for severe marine environments, where
            COLORBOND&reg; Ultra is the specified product. Whether a roof is washed by rain matters too:
            sheltered areas keep salt that rain never rinses off.
          </p>
        </article>
        <article class="reveal border-t-2 border-ink pt-6" style="--d:1">
          <h3 class="t-title text-2xl">Bushfire-prone land</h3>
          <p class="mt-4 max-w-[52ch] text-muted">
            Much of the {site.base.region} is mapped as bushfire prone. Where a Bushfire Attack Level
            applies, AS&nbsp;3959 sets requirements for sealing ridges and eaves against embers and for
            gutter and valley materials. Metal sheeting is non-combustible, one reason it is common here.
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* Process. A horizontal sequence; confirmed by ENJ before it goes live. */}
  {
    showProcess && (
      <section class="bg-paper py-(--spacing-section)">
        <div class="container-page">
          <SectionLabel index="03" text="Process" />
          <h2 class="t-headline mt-5 text-4xl">How a job runs</h2>
          <Awaiting
            when={!processConfirmed}
            note="Confirm these steps describe how ENJ runs a job. Hidden at launch until confirmed."
            class="mt-12"
          >
            <ol class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
              {processSteps.map((step, i) => (
                <li class="relative">
                  <span class="reveal-rule block h-px w-full bg-ink" style={`--d:${i}`} />
                  <span class="label tabular mt-5 block text-red">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="t-title mt-4 text-xl">{step.title}</h3>
                  <p class="mt-3 text-muted">{step.body}</p>
                </li>
              ))}
            </ol>
          </Awaiting>
        </div>
      </section>
    )
  }

  {/* Testimonials render only once genuine, verified reviews exist. */}
  {
    testimonials.length > 0 && (
      <section class="bg-paper-2 py-(--spacing-section)">
        <div class="container-page">
          <h2 class="t-headline text-4xl">What customers say</h2>
          <ul class="mt-12 grid gap-10 md:grid-cols-2">
            {testimonials.map((t) => (
              <li class="border-t border-line pt-6">
                <blockquote class="t-lead">&ldquo;{t.data.quote}&rdquo;</blockquote>
                <p class="label mt-5 text-muted">
                  {t.data.author}
                  {t.data.suburb && `, ${t.data.suburb}`}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {/* Close. */}
  <section class="bg-ink py-(--spacing-section-lg) text-paper">
    <div class="container-page grid gap-14 lg:grid-cols-12 lg:items-end lg:gap-8">
      <div class="lg:col-span-6">
        <h2 class="t-headline max-w-[14ch] text-5xl">Tell us about your roof</h2>
        <p class="t-lead mt-7 max-w-[40ch] text-muted-dark">Send the details or call directly. Quotes are free.</p>
        <Button href={quoteHref} size="lg" class="mt-10 w-full sm:w-auto">Get a free quote</Button>
      </div>
      <CallList class="lg:col-span-5 lg:col-start-8" />
    </div>
  </section>
</Base>

<style>
  .hero {
    --hero-h: clamp(34rem, calc(100svh - var(--header-h)), 54rem);
  }
  /* Aligns the hero copy with the page container while the photo bleeds right. */
  .hero-copy {
    container-type: inline-size;
    padding-left: max(var(--spacing-gutter), calc((100vw - var(--container-page)) / 2 + var(--spacing-gutter)));
    padding-right: var(--spacing-gutter);
  }
  /* Sized to the column, not the viewport. "the South Coast" measures about
     10.5 font-sizes wide, so 9.3% of the column keeps the headline to two
     lines at every desktop width. */
  .hero-title {
    font-size: clamp(2.5rem, 9.3cqi, 6.25rem);
  }
</style>
