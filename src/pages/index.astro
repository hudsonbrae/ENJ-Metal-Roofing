---
import Base from '../layouts/Base.astro';
import Button from '../components/primitives/Button.astro';
import SectionLabel from '../components/primitives/SectionLabel.astro';
import Photo from '../components/media/Photo.astro';
import AssetSlot from '../components/media/AssetSlot.astro';
import CallList from '../components/contact/CallList.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import WorkIndex from '../components/projects/WorkIndex.astro';
import Awaiting from '../components/review/Awaiting.astro';
import { site } from '../data/site';
import { quoteHref } from '../data/navigation';
import { processConfirmed, processIntro, processSteps } from '../data/process';
import { concerns, conditions } from '../data/roof-concerns';
import { reviewMode } from '../lib/mode';
import { url } from '../lib/paths';
import {
  detailPhotos,
  getProjects,
  getServices,
  getTestimonials,
  heroWorkmanship,
  leadPhoto,
} from '../lib/content';

const projects = await getProjects();
const services = await getServices();
const testimonials = await getTestimonials();
const heroShot = await heroWorkmanship();

const [featured, ...otherProjects] = projects;

// Hero: the workmanship photo chosen for it, otherwise the featured
// project's lead photo.
const heroPhoto = heroShot?.data ?? (featured ? leadPhoto(featured) : undefined);
const heroIsFixture = !heroShot && Boolean(featured?.isFixture);
const heroFocus = heroShot?.data.focus ?? '50% 50%';

// The featured work card must not repeat the hero photo.
const featureShot = featured
  ? heroShot
    ? leadPhoto(featured)
    : (featured.data.gallery.find((p) => p.kind !== 'detail' && p.src !== heroPhoto?.src) ??
      featured.data.beforeAfter[0]?.after)
  : undefined;
const indexProjects = featureShot ? otherProjects : projects;
const details = await detailPhotos(projects, 3);
const showProcess = processConfirmed || reviewMode;

// The two services offered as shortcuts in the hero, as Simmark does.
const heroServices = services.slice(0, 2);
---

<Base
  title="Metal Roofing in the Shoalhaven"
  description={`Metal roofing across ${site.base.regionPhrase}, NSW, built for salt air, coastal wind and bushfire country. Call John or Ethan, or ask for a free quote online.`}
  overlayHeader
>
  {/* Hero. Full-bleed photo of ENJ's work, text over it. */}
  <section data-hero class="hero relative flex items-end overflow-hidden bg-ink text-paper">
    <div class="absolute inset-0">
      {
        heroPhoto ? (
          <Photo
            src={heroPhoto.src}
            alt={heroPhoto.alt}
            use="full"
            fill
            priority
            position={heroFocus}
            fixture={heroIsFixture}
            class="settle"
          />
        ) : (
          reviewMode && <AssetSlot role="Hero" fill brief="A finished ENJ roof, full width." />
        )
      }
    </div>
    <div class="hero-shade pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <span data-hero-sentinel class="pointer-events-none absolute inset-x-0 top-0 h-[60%]" aria-hidden="true"></span>

    <div class="container-page relative pb-12 pt-36 sm:pb-24 sm:pt-40 lg:pb-28">
      <p class="hero-in label text-paper/80" style="--d:0">Metal roofing across {site.base.regionPhrase}</p>
      <h1 class="hero-in hero-title mt-6 max-w-[12ch] sm:max-w-[16ch]" style="--d:1">Your home, covered properly.</h1>
      <p class="hero-in t-lead mt-7 max-w-[44ch] text-paper/85" style="--d:2">
        Metal roofing built for salt air, coastal wind and bushfire country.
      </p>
      <div class="hero-in mt-10 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap" style="--d:3">
        <div class="col-span-2 grid sm:contents">
          <Button href={quoteHref} size="lg">Get a free quote</Button>
        </div>
        {
          heroServices.map((service) => (
            <a href={url(`/services/${service.id}/`)} class="btn btn-lg btn-glass max-sm:px-3">
              {service.data.shortTitle ?? service.data.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* Process, straight after the hero as Simmark runs it: brand-colour band,
      numbered circles joined by arrows. */}
  {
    showProcess && (
      <section class="process bg-red py-20 text-paper sm:py-24">
        <div class="container-page">
          <p class="reveal label text-paper/70">The process</p>
          <h2 class="reveal t-headline mt-4 text-4xl" style="--d:1">
            {processIntro.title}
          </h2>
          <p class="reveal t-lead mt-4 max-w-[60ch] text-paper/80" style="--d:2">
            {processIntro.lead}
          </p>
          <Awaiting
            when={!processConfirmed}
            tone="brand"
            note="Confirm these steps describe how ENJ runs a job. Hidden at launch until confirmed."
            class="mt-14"
          >
            <ol class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
              {processSteps.map((step, i) => (
                <li class="reveal relative" style={`--d:${i}`}>
                  <div class="flex items-center gap-5">
                    <span class="process-num tabular">{i + 1}</span>
                    {i < processSteps.length - 1 && (
                      <span class="process-arrow mr-5 hidden flex-1 lg:block" aria-hidden="true" />
                    )}
                  </div>
                  <h3 class="t-title mt-5 text-lg">{step.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-paper/85">{step.body}</p>
                </li>
              ))}
            </ol>
          </Awaiting>
        </div>
      </section>
    )
  }

  {/* Recent work. */}
  {
    featured && (
      <section class="bg-paper py-(--spacing-section)">
        <div class="container-page">
          <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
            <div>
              <SectionLabel index="01" text="Work" />
              <h2 class="t-headline mt-5 text-4xl">Recent work</h2>
            </div>
            <a href={url('/projects/')} class="label link py-2 text-red">
              All work
            </a>
          </div>
          {featureShot && <ProjectCard project={featured} size="feature" photo={featureShot} />}
          {indexProjects.length > 0 && (
            <div class:list={[featureShot && 'mt-16 sm:mt-20']}>
              <WorkIndex projects={indexProjects} />
            </div>
          )}
        </div>
      </section>
    )
  }

  {/* Worried about your roof? Signs worth acting on, next to real close-ups. */}
  <section class="bg-ink py-(--spacing-section) text-paper">
    <div class="container-page grid gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <h2 class="reveal t-headline text-4xl">Worried about your roof?</h2>
        <p class="reveal t-lead mt-6 max-w-[40ch] text-muted-dark" style="--d:1">
          Most roof problems start small and out of sight. These are the ones worth catching early.
        </p>
        <ul class="mt-10 border-t border-line-dark">
          {
            concerns.map((item, i) => (
              <li class="reveal border-b border-line-dark py-5" style={`--d:${i + 1}`}>
                <h3 class="t-title flex items-baseline gap-4 text-xl">
                  <span class="label tabular text-crimson">{String(i + 1).padStart(2, '0')}</span>
                  {item.title}
                </h3>
                <p class="mt-2 pl-10 text-muted-dark">{item.body}</p>
              </li>
            ))
          }
        </ul>
        <div class="reveal mt-10 flex flex-col gap-3 sm:flex-row" style="--d:6">
          <Button href={quoteHref} size="lg">Get your roof checked</Button>
        </div>
      </div>

      {
        details.length > 0 && (
          <div class="grid content-start gap-4 sm:grid-cols-2 sm:gap-5 lg:col-span-6 lg:col-start-7">
            {details.map(({ photo, fixture }, i) => (
              <Photo
                src={photo.src}
                alt={photo.alt}
                use={i === 0 ? 'card' : 'third'}
                ratio={i === 0 && details.length > 1 ? '4/5' : '4/3'}
                fixture={fixture}
                reveal
                class:list={[i === 0 && details.length > 1 && 'sm:row-span-2']}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>

  {/* Services. */}
  {
    services.length > 0 && (
      <section class="bg-paper py-(--spacing-section)">
        <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-8">
          <div class="lg:col-span-4">
            <SectionLabel index="02" text="Services" />
            <h2 class="t-headline mt-5 max-w-[12ch] text-4xl">What ENJ does</h2>
            <a href={url('/services/')} class="label link mt-8 inline-block py-2 text-red">
              All services
            </a>
            {services.some((s) => s.data.draft) && (
              <Awaiting
                note="Services marked draft are shown for review. ENJ to confirm which are advertised; unconfirmed ones are hidden at launch."
                class="mt-10"
              >
                <span />
              </Awaiting>
            )}
          </div>
          <ol class="border-t border-line lg:col-span-8">
            {services.map((service, i) => (
              <li class="border-b border-line">
                <a
                  href={url(`/services/${service.id}/`)}
                  class="group grid grid-cols-[3rem_minmax(0,1fr)] gap-x-4 py-7 sm:grid-cols-[4rem_minmax(0,1fr)]"
                >
                  <span class="label tabular pt-2 text-red">{String(i + 1).padStart(2, '0')}</span>
                  <span>
                    <span class="t-title block text-2xl transition-colors group-hover:text-red lg:text-3xl">
                      {service.data.title}
                    </span>
                    <span class="mt-3 block max-w-[56ch] text-muted">{service.data.summary}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {/* Roofs that last. What the roof has to stand up to here. */}
  <section class="bg-paper-2 py-(--spacing-section)">
    <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <p class="reveal label text-red">Looking out for your home</p>
        <h2 class="reveal t-headline mt-5 text-5xl" style="--d:1">Roofs that last</h2>
        <p class="reveal t-lead mt-6 max-w-[34ch] text-muted" style="--d:2">
          We help you choose the right roof for where you live.
        </p>
      </div>
      <ul class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:col-span-7 lg:col-start-6">
        {
          conditions.map((item, i) => (
            <li class="reveal" style={`--d:${i}`}>
              <span class="reveal-rule block h-0.5 w-10 bg-red" style={`--d:${i}`} aria-hidden="true" />
              <h3 class="t-title mt-5 text-2xl">{item.title}</h3>
              <p class="mt-3 max-w-[40ch] text-muted">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Testimonials render only once genuine, verified reviews exist. */}
  {
    testimonials.length > 0 && (
      <section class="bg-paper-2 py-(--spacing-section)">
        <div class="container-page">
          <h2 class="t-headline text-4xl">What customers say</h2>
          <ul class="mt-12 grid gap-10 md:grid-cols-2">
            {testimonials.map((t) => (
              <li class="border-t border-line pt-6">
                <blockquote class="t-lead">&ldquo;{t.data.quote}&rdquo;</blockquote>
                <p class="label mt-5 text-muted">
                  {t.data.author}
                  {t.data.suburb && `, ${t.data.suburb}`}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {/* Close. */}
  <section class="bg-ink py-(--spacing-section-lg) text-paper">
    <div class="container-page grid gap-14 lg:grid-cols-12 lg:items-end lg:gap-8">
      <div class="lg:col-span-6">
        <p class="reveal label text-crimson">Let's talk</p>
        <h2 class="reveal t-headline mt-5 max-w-[14ch] text-5xl" style="--d:1">Tell us about your roof</h2>
        <p class="reveal t-lead mt-7 max-w-[40ch] text-muted-dark" style="--d:2">
          Send the details or call directly. Quotes are free.
        </p>
        <Button href={quoteHref} size="lg" class="mt-10 w-full sm:w-auto">Get a free quote</Button>
      </div>
      <CallList class="lg:col-span-5 lg:col-start-8" />
    </div>
  </section>
</Base>

<style>
  /* Pulled up under the sticky header so the photo runs to the top edge. */
  .hero {
    margin-top: calc(-1 * var(--header-h));
    min-height: clamp(38rem, 100svh, 62rem);
  }
  /* Darkens the photo enough for white text on any image: heavier at the
     bottom-left where the text sits, lighter top-right where the work shows. */
  .hero-shade {
    background:
      linear-gradient(to top, rgb(24 5 6 / 0.85) 0%, rgb(24 5 6 / 0.25) 55%, rgb(24 5 6 / 0.3) 100%),
      linear-gradient(to right, rgb(24 5 6 / 0.55) 0%, rgb(24 5 6 / 0) 70%);
  }
  .hero-title {
    font-size: clamp(2.75rem, 1.4rem + 4.6vw, 6rem);
    font-stretch: 104%;
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  /* Hero copy rises in on load, after the photo starts settling. */
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  :global(.motion-ok) .hero-in {
    animation: hero-in 900ms var(--ease-expo) both;
    animation-delay: calc(250ms + var(--d, 0) * 110ms);
  }

  .btn-glass {
    border-color: rgb(255 255 255 / 0.45);
    background: rgb(255 255 255 / 0.08);
    color: var(--color-white);
    backdrop-filter: blur(8px);
  }
  .btn-glass:hover {
    background: var(--color-white);
    color: var(--color-ink);
  }

  .process-num {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid rgb(255 255 255 / 0.35);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
    font-weight: 700;
  }
  .process-arrow {
    position: relative;
    height: 2px;
    background: rgb(255 255 255 / 0.5);
  }
  .process-arrow::after {
    content: '';
    position: absolute;
    right: -2px;
    top: 50%;
    border-left: 14px solid rgb(255 255 255 / 0.5);
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    transform: translateY(-50%);
  }
</style>
