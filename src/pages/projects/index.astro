---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import AssetSlot from '../../components/media/AssetSlot.astro';
import Button from '../../components/primitives/Button.astro';
import { getProjects } from '../../lib/content';
import { breadcrumbSchema } from '../../lib/seo/schema';
import { site } from '../../data/site';
import { quoteHref } from '../../data/navigation';

const projects = await getProjects();
const [lead, ...rest] = projects;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Work', url: '/projects/' },
  ]),
];
---

<Base
  title="Our Work"
  description={`Metal roofing projects completed by ENJ Metal Roofing across ${site.base.regionPhrase}, NSW.`}
  {schemas}
>
  <PageHeader
    tone="paper"
    title="Our work"
    intro="Completed roofs, photographed closely enough to judge the workmanship."
    trail={[{ label: 'Work', href: '/projects/' }]}
  />

  <section class="bg-paper pb-(--spacing-section) pt-12 sm:pt-16">
    <div class="container-page">
      {
        lead ? (
          <div class="space-y-20 sm:space-y-24">
            <ProjectCard project={lead} size="feature" headingLevel="h2" />
            {rest.length > 0 && (
              <ul class="grid gap-x-6 gap-y-16 md:grid-cols-2 lg:gap-x-8">
                {rest.map((project) => (
                  <li>
                    <ProjectCard project={project} headingLevel="h2" />
                  </li>
                ))}
              </ul>
            )}
          </div>
        ) : (
          <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start lg:gap-20">
            <div class="max-w-[52ch]">
              <h2 class="t-headline text-3xl">Project photography is on its way</h2>
              <p class="t-lead mt-6 text-muted">
                This page shows ENJ's own completed roofs, not stock images. Recent jobs are posted on{' '}
                <a href={site.social.instagram} target="_blank" rel="me noopener" class="link link-static text-red">
                  Instagram
                </a>{' '}
                in the meantime.
              </p>
              <Button href={quoteHref} class="mt-10">Get a free quote</Button>
            </div>
            <AssetSlot
              role="Project"
              ratio="4/3"
              tone="light"
              brief="First completed ENJ project: a wide shot of the whole roof with the house in context."
            />
          </div>
        )
      }
    </div>
  </section>
</Base>
