---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { breadcrumbSchema } from '../../lib/seo/schema';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const data = project.data;

// Only facts that exist are shown. Nothing is substituted for a missing value.
const specs = [
  data.suburb && { label: 'Location', value: [data.suburb, data.state].filter(Boolean).join(', ') },
  data.year && { label: 'Completed', value: String(data.year) },
  data.roofProfile && { label: 'Profile', value: data.roofProfile },
  data.material && { label: 'Material', value: data.material },
  data.colour && { label: 'Colour', value: data.colour },
].filter(Boolean) as { label: string; value: string }[];

const hero = data.images.find((img) => img.role === 'hero') ?? data.images[0];
const rest = data.images.filter((img) => img !== hero);

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Work', url: '/projects/' },
    { name: data.title, url: `/projects/${project.id}/` },
  ]),
];
---

<Base
  title={data.title}
  description={data.summary ?? `${data.title} — a metal roofing project by ENJ Metal Roofing.`}
  {schemas}
>
  <PageHeader
    eyebrow={data.type.replace('-', ' ')}
    title={data.title}
    intro={data.summary}
    trail={[{ label: 'Work', href: '/projects/' }]}
  />

  {
    hero && (
      <Image
        src={hero.src}
        alt={hero.alt}
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        class="w-full object-cover"
        style="aspect-ratio:16/9"
        loading="eager"
        fetchpriority="high"
      />
    )
  }

  <section class="bg-paper py-section">
    <div class="container-page">
      <div class="grid gap-14 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
        <aside>
          {
            specs.length > 0 && (
              <dl class="border-t border-line">
                {specs.map((spec) => (
                  <div class="flex justify-between gap-6 border-b border-line py-4">
                    <dt class="label" style="color:var(--color-muted)">{spec.label}</dt>
                    <dd class="text-sm text-right" style="font-weight:600">{spec.value}</dd>
                  </div>
                ))}
              </dl>
            )
          }

          {
            data.scope && data.scope.length > 0 && (
              <div class="mt-10 border-t border-line pt-6">
                <h2 class="label" style="color:var(--color-red)">Scope</h2>
                <ul class="mt-5 space-y-3">
                  {data.scope.map((item) => (
                    <li class="flex gap-3 text-sm leading-relaxed">
                      <span style="color:var(--color-red)" aria-hidden="true">—</span>
                      <span style="color:var(--color-muted)">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <a
            href="/contact/"
            class="mt-10 block rounded-sm bg-cta px-6 py-4 text-center text-xs uppercase text-white transition-colors duration-200 hover:bg-red"
            style="font-stretch:88%;font-weight:600;letter-spacing:var(--tracking-wider)"
          >
            Get a quote like this
          </a>
        </aside>

        <div class="prose-enj max-w-prose">
          <Content />
        </div>
      </div>

      {
        rest.length > 0 && (
          <div class="mt-16 grid gap-5 sm:grid-cols-2">
            {rest.map((img) => (
              <figure>
                <Image
                  src={img.src}
                  alt={img.alt}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  class="w-full object-cover"
                  loading="lazy"
                />
                {img.caption && (
                  <figcaption class="label mt-3" style="color:var(--color-muted)">
                    {img.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Base>
