---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { breadcrumbSchema } from '../lib/seo/schema';
import { site } from '../data/site';

const sent = Astro.url.searchParams.get('sent') === '1';
const failed = Astro.url.searchParams.get('error') === '1';

const workTypes = [
  'Re-roofing / roof replacement',
  'New roof (new build or extension)',
  'Roof repair or leak',
  'Guttering, fascia or downpipes',
  'Not sure — need an inspection',
];

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact/' },
  ]),
];

const field =
  'w-full rounded-sm border border-line bg-white px-4 py-3.5 text-base text-ink ' +
  'transition-colors duration-200 placeholder:text-muted/60 focus:border-red ' +
  'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 ' +
  'focus-visible:outline-crimson';
const labelCls = 'label mb-2.5 block';
---

<Base
  title="Get a Free Roofing Quote — Ulladulla NSW"
  description={`Request a free metal roofing quote from ENJ Metal Roofing in ${site.base.suburb} NSW. Call John or Ethan, or send through the details of your roof.`}
  {schemas}
>
  <PageHeader
    eyebrow="Get a quote"
    title="Tell us about your roof"
    intro="Send through the address and what needs looking at, or call directly. Quotes are free and there is no obligation."
    trail={[{ label: 'Contact', href: '/contact/' }]}
  />

  <section class="bg-paper py-section">
    <div class="container-page">
      <div class="grid gap-14 lg:grid-cols-[1.25fr_1fr] lg:gap-20">
        <div>
          {
            sent && (
              <div
                class="mb-10 border-l-2 bg-paper-2 p-6"
                style="border-color:var(--color-red)"
                role="status"
              >
                <h2 class="display text-xl">Enquiry sent</h2>
                <p class="mt-3 max-w-[52ch] leading-relaxed" style="color:var(--color-muted)">
                  It has gone through to {site.contacts.map((c) => c.name).join(' and ')}.
                  If it is urgent, calling is the fastest way to get hold of
                  someone on site.
                </p>
              </div>
            )
          }

          {
            failed && (
              <div
                class="mb-10 border-l-2 bg-paper-2 p-6"
                style="border-color:var(--color-crimson)"
                role="alert"
              >
                <h2 class="display text-xl">That didn't send</h2>
                <p class="mt-3 max-w-[52ch] leading-relaxed" style="color:var(--color-muted)">
                  Something went wrong at our end. Please call
                  {' '}
                  <a href={`tel:${site.contacts[0].phone}`} style="color:var(--color-red)">
                    {site.contacts[0].display}
                  </a>
                  {' '}or email{' '}
                  <a href={`mailto:${site.email}`} style="color:var(--color-red)">
                    {site.email}
                  </a>.
                </p>
              </div>
            )
          }

          <form
            method="POST"
            action="/api/quote"
            data-quote-form
            class="space-y-7"
            novalidate={false}
          >
            {/* Spam traps: invisible to people, irresistible to bots. */}
            <div class="absolute left-[-9999px]" aria-hidden="true">
              <label for="company">Company (leave blank)</label>
              <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="started" data-started value="" />

            <div class="grid gap-7 sm:grid-cols-2">
              <div>
                <label for="name" class={labelCls}>Name <span style="color:var(--color-crimson)">*</span></label>
                <input
                  type="text" id="name" name="name" required autocomplete="name"
                  class={field} placeholder="Your name"
                />
              </div>
              <div>
                <label for="phone" class={labelCls}>Phone <span style="color:var(--color-crimson)">*</span></label>
                <input
                  type="tel" id="phone" name="phone" required autocomplete="tel"
                  inputmode="tel" class={field} placeholder="04.. ... ..."
                />
              </div>
            </div>

            <div class="grid gap-7 sm:grid-cols-2">
              <div>
                <label for="suburb" class={labelCls}>Suburb <span style="color:var(--color-crimson)">*</span></label>
                <input
                  type="text" id="suburb" name="suburb" required
                  autocomplete="address-level2" class={field} placeholder="Where is the property?"
                />
              </div>
              <div>
                <label for="email" class={labelCls}>Email <span style="color:var(--color-muted)">(optional)</span></label>
                <input
                  type="email" id="email" name="email" autocomplete="email"
                  class={field} placeholder="you@example.com"
                />
              </div>
            </div>

            <div>
              <label for="workType" class={labelCls}>What do you need? <span style="color:var(--color-crimson)">*</span></label>
              <select id="workType" name="workType" required class={field}>
                <option value="">Select one</option>
                {workTypes.map((type) => <option value={type}>{type}</option>)}
              </select>
            </div>

            <div>
              <label for="details" class={labelCls}>Details</label>
              <textarea
                id="details" name="details" rows="5" class={field}
                placeholder="Roof type, age, what you've noticed, anything useful."
              ></textarea>
              <p class="mt-2.5 text-xs" style="color:var(--color-muted)">
                Photos help a lot. If you have some, mention it here and we'll
                reply with an address to send them to.
              </p>
            </div>

            <button
              type="submit"
              class="w-full rounded-sm bg-cta px-8 py-4.5 text-xs uppercase text-white transition-colors duration-200 hover:bg-red sm:w-auto"
              style="font-stretch:88%;font-weight:600;letter-spacing:var(--tracking-wider)"
            >
              Send enquiry
            </button>
          </form>
        </div>

        <aside>
          <div class="border-t border-line pt-6">
            <h2 class="label" style="color:var(--color-red)">Call directly</h2>
            <ul class="mt-6 space-y-6">
              {
                site.contacts.map((c) => (
                  <li>
                    <a href={`tel:${c.phone}`} class="group block">
                      <span class="label block" style="color:var(--color-muted)">{c.name}</span>
                      <span class="display mt-1.5 block text-2xl transition-colors duration-200 group-hover:text-red">
                        {c.display}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="mt-10 border-t border-line pt-6">
            <h2 class="label" style="color:var(--color-red)">Email</h2>
            <a
              href={`mailto:${site.email}`}
              class="mt-4 block break-all transition-colors duration-200 hover:text-red"
              style="color:var(--color-muted)"
            >
              {site.email}
            </a>
          </div>

          <div class="mt-10 border-t border-line pt-6">
            <h2 class="label" style="color:var(--color-red)">Based in</h2>
            <p class="mt-4" style="color:var(--color-muted)">
              {site.base.suburb}, {site.base.state} {site.base.postcode}
            </p>
          </div>

          <div class="mt-10 border-t border-line pt-6">
            <h2 class="label" style="color:var(--color-red)">Instagram</h2>
            <a
              href={site.social.instagram}
              target="_blank"
              rel="me noopener"
              class="mt-4 block transition-colors duration-200 hover:text-red"
              style="color:var(--color-muted)"
            >
              {site.social.instagramHandle}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  // Progressive enhancement. The form is fully functional without this:
  // native constraint validation and a normal POST already work.
  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
  const started = form?.querySelector<HTMLInputElement>('[data-started]');

  if (started) started.value = String(Date.now());

  form?.addEventListener('submit', (event) => {
    let firstInvalid: HTMLElement | null = null;

    form.querySelectorAll<HTMLInputElement>('input, select, textarea').forEach((el) => {
      const message = el.closest('div')?.querySelector('[data-error]');
      message?.remove();
      el.removeAttribute('aria-invalid');

      if (!el.checkValidity() && el.name !== 'company') {
        el.setAttribute('aria-invalid', 'true');
        const p = document.createElement('p');
        p.setAttribute('data-error', '');
        p.id = `${el.id}-error`;
        p.className = 'mt-2 text-xs';
        p.style.color = 'var(--color-red)';
        p.textContent = el.validationMessage;
        el.setAttribute('aria-describedby', p.id);
        el.closest('div')?.appendChild(p);
        if (!firstInvalid) firstInvalid = el;
      }
    });

    if (firstInvalid) {
      event.preventDefault();
      (firstInvalid as HTMLElement).focus();
    }
  });
</script>
