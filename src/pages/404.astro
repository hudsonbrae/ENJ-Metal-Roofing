---
import Base from '../layouts/Base.astro';
import Button from '../components/primitives/Button.astro';
import { primaryContact } from '../data/site';
---

<Base title="Page not found" description="That page does not exist on the ENJ Metal Roofing website." noindex>
  <section class="bg-ink py-(--spacing-section-lg) text-paper">
    <div class="container-page">
      <p class="label text-crimson">Page not found</p>
      <h1 class="t-display mt-7 max-w-[14ch] text-5xl">That page isn't here</h1>
      <p class="t-lead mt-7 max-w-[46ch] text-muted-dark">
        The link may be out of date. Everything on the site is reachable from the menu, or you can call
        {' '}{primaryContact.name} directly.
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <Button href="/">Back to home</Button>
        <Button href={`tel:${primaryContact.phone}`} variant="secondary-dark">
          <span>Call {primaryContact.name}</span>
          <span class="tabular font-normal opacity-80">{primaryContact.display}</span>
        </Button>
      </div>
    </div>
  </section>
</Base>
