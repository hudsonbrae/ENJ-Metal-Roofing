---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Button from '../components/primitives/Button.astro';
import AssetSlot from '../components/media/AssetSlot.astro';
import CallList from '../components/contact/CallList.astro';
import Awaiting from '../components/review/Awaiting.astro';
import { breadcrumbSchema } from '../lib/seo/schema';
import { site, hasLicence, hasAbn, ownerNames } from '../data/site';
import { quoteHref } from '../data/navigation';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about/' },
  ]),
];
---

<Base
  title="About ENJ"
  description={`ENJ Metal Roofing is a metal roofing business in ${site.base.regionPhrase}, NSW, owned by ${ownerNames}. Talk to them directly about your roof.`}
  {schemas}
>
  <PageHeader
    tone="paper"
    title="About ENJ"
    intro={`A metal roofing business in ${site.base.regionPhrase}, on the New South Wales South Coast, owned by ${ownerNames}. You deal with them directly.`}
    trail={[{ label: 'About', href: '/about/' }]}
  />

  <section class="bg-paper py-(--spacing-section)">
    <div class="container-page grid gap-16 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
          <AssetSlot
            role="Team"
            ratio="4/5"
            brief="John and Ethan on site in work gear, with a roof behind them. A real photograph: no stock images, no AI-generated people."
          />
        </div>
      </div>

      <div class="max-w-prose space-y-16 lg:col-span-6 lg:col-start-7">
        <div>
          <h2 class="t-headline text-3xl">A new business</h2>
          <p class="t-lead mt-6 text-muted">
            ENJ Metal Roofing is new. Rather than lead with claims, this site shows the work itself,
            photographed closely enough to judge the standard for yourself.
          </p>
        </div>

        <div>
          <h2 class="t-headline text-3xl">Why metal</h2>
          <p class="mt-6 text-muted">
            Metal roofing suits this part of the coast. It is far lighter than tile, it sheds water at
            lower pitches than tiles can, and steel sheeting is non-combustible, which matters on
            bushfire-prone land. It is also widely used to collect rainwater for tanks.
          </p>
          <p class="mt-5 text-muted">
            It is less forgiving of poor detailing. A metal roof is only as good as its flashings and its
            fixing pattern.
          </p>
        </div>

        <div>
          <h2 class="t-headline text-3xl">Who you'll deal with</h2>
          <p class="mt-6 text-muted">
            ENJ is owned by {ownerNames}. Call either of them directly about your roof.
          </p>
          <CallList tone="paper" class="mt-8" />
        </div>

        {
          (hasLicence || hasAbn) && (
            <dl class="divide-y divide-line border-y border-line">
              {hasLicence && (
                <div class="flex items-baseline justify-between gap-6 py-4">
                  <dt class="label text-muted">{site.licence.authority} licence</dt>
                  <dd class="tabular font-semibold">{site.licence.number}</dd>
                </div>
              )}
              {hasAbn && (
                <div class="flex items-baseline justify-between gap-6 py-4">
                  <dt class="label text-muted">ABN</dt>
                  <dd class="tabular font-semibold">{site.abn}</dd>
                </div>
              )}
            </dl>
          )
        }

        <Awaiting note="Supply licence number, ABN and public liability insurance details. Each appears here and in the footer once added to src/data/site.ts.">
          <p class="text-sm text-muted">Licence, ABN and insurance details will appear here.</p>
        </Awaiting>
      </div>
    </div>
  </section>

  <section class="bg-ink py-(--spacing-section) text-paper">
    <div class="container-page flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
      <h2 class="t-headline max-w-[16ch] text-4xl">Get a quote on your roof</h2>
      <Button href={quoteHref} size="lg">Get a free quote</Button>
    </div>
  </section>
</Base>
