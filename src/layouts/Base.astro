---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileActionBar from '../components/layout/MobileActionBar.astro';
import ReviewBanner from '../components/review/ReviewBanner.astro';
import { url } from '../lib/paths';
// Same fingerprinted file global.css loads, so the preload is reused.
import fontUrl from '../assets/fonts/archivo-var.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schemas?: unknown[];
  /** The sticky mobile call/quote bar. Off on pages that are already the quote flow. */
  actionBar?: boolean;
  /** Page opens with a full-bleed hero the header floats over. */
  overlayHeader?: boolean;
}

const { title, description, image, noindex, schemas, actionBar = true, overlayHeader = false } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Runs before first paint. Motion only engages with JavaScript and a
        no-preference motion setting; otherwise everything renders static. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
        root.classList.add('motion-ok');
        // If the reveal script never arrives, show everything rather than
        // leave content hidden.
        setTimeout(function () {
          if (!root.classList.contains('motion-ready')) root.classList.remove('motion-ok');
        }, 2500);
      })();
    </script>

    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={url('/brand/favicon-512.png')} type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href={url('/brand/apple-touch-icon.png')} />
    <meta name="theme-color" content="#290B0D" />

    <Seo {title} {description} {image} {noindex} {schemas} />
  </head>

  <body class:list={[actionBar && 'pb-16 lg:pb-0']}>
    <a
      href="#main"
      class="btn btn-primary btn-sm sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70]"
    >
      Skip to content
    </a>

    <ReviewBanner />
    <Header overlay={overlayHeader} />

    <main id="main">
      <slot />
    </main>

    <Footer />
    {actionBar && <MobileActionBar />}

    {/* Scroll reveals. One observer for the whole page; elements are
        revealed once and then released. */}
    <script>
      const root = document.documentElement;
      if (root.classList.contains('motion-ok') && 'IntersectionObserver' in window) {
        root.classList.add('motion-ready');
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        document
          .querySelectorAll('.reveal, .reveal-rule, .reveal-image')
          .forEach((el) => observer.observe(el));
      } else {
        root.classList.remove('motion-ok');
      }
    </script>
  </body>
</html>
