{
  "name": "enj-metal-roofing",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --background",
    "dev:launch": "astro dev --background --mode launch",
    "dev:stop": "astro dev stop",
    "build": "astro build && node scripts/check-launch-build.mjs",
    "build:review": "astro build --mode review",
    "preview": "node ./dist/server/entry.mjs",
    "assets:brand": "node scripts/brand-assets.mjs",
    "assets:fixtures": "node scripts/make-fixtures.mjs",
    "test": "astro build --mode review && playwright test",
    "qa:screenshots": "node scripts/qa/screenshots.mjs",
    "qa:crawl": "node scripts/qa/crawl.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/node": "^11.1.6",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.141.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
